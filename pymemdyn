#!/usr/bin/env python3
import argparse
import os

import settings
import forcefield_defaults
from run import Run

import logging

if __name__ == "__main__":

    parser = argparse.ArgumentParser(
        prog='pymemdyn',
        description=' == Setup Molecular Dynamics for Membrane Proteins given a PDB. == ')

    parser.add_argument('-v', '--version',
                        action='version',
                        version='%(prog)s 2.0')

    parser.add_argument('-b',
                        dest = "own_dir",
                        help = "Working dir if different from actual dir",
                        default = os.getcwd())

    parser.add_argument('-r',
                        dest = "repo_dir",
                        help = "Path to templates of fixed files. If not \
            provided, take the value from settings.TEMPLATES_DIR.",
                        default = settings.TEMPLATES_DIR)

    parser.add_argument('-p',
                        dest = "pdb",
                        required = True,
                        help = "Name of the PDB file to insert into membrane for MD (mandatory). \
            Use the .pdb extension. (e.g. -p myprot.pdb)")

    parser.add_argument('-l', '--lig',
                        dest = "ligand",
                        help = "Ligand identifiers of ligands present within the PDB file. If \
            multiple ligands are present, give a comma-delimited list.") 
    
    parser.add_argument('--lc',
                        dest = "ligand_charge",
                        help = "Charge of ligands for ligpargen (when itp file should be \
            generated). If multiple ligands are present, give a comma-delimited list.")

    parser.add_argument('-w','--waters',
                        dest = "waters",
                        help = "Water identifiers of crystalized water molecules present within \
            the PDB file.")

    parser.add_argument('-i', '--ions',
                        dest = "ions",
                        help = "Ion identifiers of crystalized ions present within the PDB file.")
    
    parser.add_argument('--full_relax',
                        dest = 'full_relax',
                        default = True,
                        help = "Toggle for performing full MD relaxation. If set to false, \
            the run will finish after the initial relaxation. (default = True)")
            
    parser.add_argument('--res',
                        dest = "restraint",
                        help = "Position restraints during MD production run. Options: bw \
            (Ballesteros-Weinstein Restrained Relaxation - default), ca (C-Alpha Restrained \
            Relaxation)",
                        default = "ca")
                        
    parser.add_argument('-f', "--loop_fill",
                        dest = "loop_fill",
                        help = "Amount of Å per AA to fill cut loops. The total \
            distance is calculated from the coordinates of the remaining residues. \
            The AA contour length is 3.4-4.0 Å, To allow for flexibility in the \
            loop, 2.0 Å/AA (default) is suggested. (example: -f 2.0)",
                        default = "2.0")     
    
    parser.add_argument('-q', '--queue',
                        dest = "queue",
                        help = "Queueing system to use (slurm, pbs, pbs_ib and svgd supported)",
                        default = "")

    parser.add_argument('-d', '--debug',
                        action="store_true")
    parser.add_argument('--proteinFF',
                        dest = "proteinforcefield",
                        required = True,
                        help = "Protein forcefield. Fully compatible options are oplsaa, amber14SB and CHARMM36m. Also accepts provided forcefield files if present in the working directory or in your GROMACS installation (see gromacs pdb2gmx documentation)")
    parser.add_argument('--waterFF',
                        dest = "waterforcefield",
                        default = "",
                        help = "Water forcefield. Default options are SPC for OPLS-AA protein and tip3p for AMBER and CHARMM forcefields")
    parser.add_argument('--lipidFF',
                        dest = "lipidforcefield",
                        default = "",
                        help = "Lipid forcefield. Default options are Berger united atom for OPLS-AA, Amber Lipid21 for AMBER and CHARMM for CHARMM forcefields")
    parser.add_argument('--ligandFF',
                        dest = "ligandforcefield",
                        default = "",
                        help = "Ligand parametrization. Currently, only supports parametrization with LigParGen for OPLS forcefields. For AMBER and CHARMM, you must provide the .itp and .ff files")

    args = parser.parse_args()

    ff_defaults = forcefield_defaults.get_forcefield_defaults(
        args.proteinforcefield)
    if ff_defaults is None:
        parser.error(
            'Unknown --proteinFF value: {0}. Supported values: {1}'.format(
                args.proteinforcefield,
                ', '.join(sorted(forcefield_defaults.FORCEFIELD_DEFAULTS.keys()))
            )
        )

    if not args.waterforcefield:
        args.waterforcefield = ff_defaults["waterff"]
    if not args.lipidforcefield:
        args.lipidforcefield = ff_defaults["lipidff"]
    if not args.ligandforcefield:
        args.ligandforcefield = ff_defaults["ligandff"]
    if args.repo_dir == settings.TEMPLATES_DIR or not args.repo_dir:
        args.repo_dir = ff_defaults["templates_dir"]

    settings.TEMPLATES_DIR = args.repo_dir

    ######## CREATE LOG ###########

    # create logger with name 'pymemdyn'
    logger = logging.getLogger('pymemdyn')

    # create file handler which logs to info messages normally and debug messages when in debug mode.
    with open('log.log', 'w+'):
        pass
    fh = logging.FileHandler('log.log')

    if args.debug:
        logger.setLevel(logging.DEBUG)
        fh.setLevel(logging.DEBUG)
    else:
        logger.setLevel(logging.INFO)
        fh.setLevel(logging.INFO)

    # create console handler with a higher log level
    ch = logging.StreamHandler()
    ch.setLevel(logging.WARNING)
    
    # create formatter and add it to the handlers
    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d,%H:%M:%S')
    fh.setFormatter(formatter)
    ch.setFormatter(formatter)
    
    # add the handlers to the logger
    logger.addHandler(fh)
    logger.addHandler(ch)

    logger.info("Pymemdyn started.")

    if not (os.path.isdir(args.own_dir)):
        os.makedirs(args.own_dir)
        logger.info("Created working dir {0}".format(args.own_dir))
    os.chdir(args.own_dir)

    run = Run(own_dir = args.own_dir,
              repo_dir = args.repo_dir,
              pdb = args.pdb,
              ligand = args.ligand,
              ligand_charge = args.ligand_charge,
              waters = args.waters,
              ions = args.ions,
              full_relax = args.full_relax,
              restraint = args.restraint,
              loop_fill = args.loop_fill,
              queue = args.queue,
              debug = args.debug,
              proteinforcefield = args.proteinforcefield,
              waterforcefield = args.waterforcefield,
              lipidforcefield = args.lipidforcefield,
              ligandforcefield = args.ligandforcefield)

    run.moldyn()

    logger.info('Done!')
